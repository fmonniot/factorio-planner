{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "v": {
      "type": "number",
      "const": 1
    },
    "dataSet": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string"
        },
        "factorioVersion": {
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    },
    "blocks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9a-f]{6}$"
          },
          "products": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "item",
                    "fluid",
                    "virtual"
                  ]
                },
                "rate": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "required": [
                "id",
                "type",
                "rate"
              ],
              "additionalProperties": false
            }
          },
          "areas": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "rows": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "recipe": {
                      "type": "string",
                      "minLength": 1
                    },
                    "machine": {
                      "type": "string",
                      "minLength": 1
                    },
                    "area": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "machines": {
                      "type": "number",
                      "minimum": 0
                    },
                    "machinesCeil": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "throughput": {
                      "type": "number",
                      "minimum": 0
                    },
                    "powerKw": {
                      "type": "number",
                      "minimum": 0
                    }
                  },
                  "required": [
                    "recipe"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "enum": [
                        "mining",
                        "offshore",
                        "power"
                      ]
                    },
                    "product": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "type": {
                          "type": "string",
                          "enum": [
                            "item",
                            "fluid",
                            "virtual"
                          ]
                        }
                      },
                      "required": [
                        "id",
                        "type"
                      ],
                      "additionalProperties": false
                    },
                    "machine": {
                      "type": "string",
                      "minLength": 1
                    },
                    "area": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "machines": {
                      "type": "number",
                      "minimum": 0
                    },
                    "machinesCeil": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "throughput": {
                      "type": "number",
                      "minimum": 0
                    },
                    "powerKw": {
                      "type": "number",
                      "minimum": 0
                    }
                  },
                  "required": [
                    "kind"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          },
          "imports": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "item",
                    "fluid",
                    "virtual"
                  ]
                },
                "rate": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "required": [
                "id",
                "type",
                "rate"
              ],
              "additionalProperties": false
            }
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string",
                  "enum": [
                    "no-recipe",
                    "duplicate-recipe",
                    "infeasible-pins",
                    "overconstrained",
                    "area-shortfall",
                    "loop-not-converged",
                    "request-loop-not-converged"
                  ]
                },
                "items": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "type": {
                        "type": "string",
                        "enum": [
                          "item",
                          "fluid",
                          "virtual"
                        ]
                      }
                    },
                    "required": [
                      "id",
                      "type"
                    ],
                    "additionalProperties": false
                  }
                },
                "recipes": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "blocks": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "areas": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                }
              },
              "required": [
                "code"
              ],
              "additionalProperties": false
            }
          },
          "connections": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "from": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "item",
                    "fluid",
                    "virtual"
                  ]
                },
                "available": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "required": [
                "from",
                "id",
                "type",
                "available"
              ],
              "additionalProperties": false
            }
          },
          "error": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "color",
          "products",
          "rows",
          "imports",
          "warnings",
          "connections"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "v",
    "dataSet",
    "blocks"
  ],
  "additionalProperties": false
}
